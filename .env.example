# Port the Express server will listen on
PORT=5000

# MongoDB connection string
# Local:   mongodb://127.0.0.1:27017/ecommerce_catalog
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecommerce_catalog
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_catalog

# URL of the frontend, used for CORS
CLIENT_URL=http://localhost:5173

# Environment: development | production
NODE_ENV=development
